# ===== Required: at least one search/LLM key for full functionality =====

# Tavily Search API (free tier: 1000 searches/month)
# Get key at: https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# OpenAI API (for LLM synthesis and article writing)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: model selection (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# ===== Application Settings =====
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
